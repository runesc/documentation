  "keyFeatures": [
    "Unified ApplicationContext mixin for Qt, Kivy, and Tkinter",
    "React-inspired Component lifecycle (component_will_mount, render, component_did_mount)",
    "Reactive state store with two-way widget data binding",
    "Automatic platform detection (Windows, macOS, Linux, Android, iOS)",
    "Hierarchical JSON settings with platform-specific overrides",
    "Multi-tier resource resolver supporting bundled (PyInstaller) and source modes",
    "Auto-configured window title and icon from settings/base.json",
    "Optional Sentry crash reporting integration",
    "Pluggable UI framework adapters (PySide6, PyQt6, PyQt5, PySide2, Kivy, Tkinter)",
    "Zero-dependency fallback with Tkinter adapter"
  ],
